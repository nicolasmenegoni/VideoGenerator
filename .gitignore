```gitignore
# Compiled and binary files
*.pyc
__pycache__/
*.o
*.obj
*.so
*.dll
*.exe

# Dependencies
venv/
.venv/
.env
.env.local
*.env.*

# Build artifacts
dist/
build/
target/

# Logs and temporary files
*.log
*.tmp
*.swp

# Editors/IDE
.vscode/
.idea/
*.swp
*.swo

# Coverage reports
coverage/
htmlcov/
.coverage

# Python specific
.mypy_cache/
.pytest_cache/
*.pyo
*.pyd

# System files
.DS_Store
Thumbs.db
```